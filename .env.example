# Copy to .env and edit.  Do NOT commit .env (it holds your password).
#   cp .env.example .env

# Run "id" on the Pi to confirm; the default pi user is usually 1000:1000
PUID=1000
PGID=1000

# Your timezone, e.g. America/New_York, America/Chicago, Europe/London
TZ=America/New_York

# Small, write-heavy app config/databases. Keep on fast, durable storage (NVMe).
CONFIG_ROOT=./appdata

# LARGE media + downloads. Point this at your mounted 1-2TB drive, e.g. /mnt/storage
# It will contain:  media/movies, media/tv, torrents/
DATA_ROOT=./data

# Pi-hole admin password (change this!)
PIHOLE_PASSWORD=change-me-please
